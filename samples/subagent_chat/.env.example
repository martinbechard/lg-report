# Copy to .env in this sample directory. Offline mode ignores provider settings.
# --live uses these settings. Existing shell environment variables take precedence.
LG_PROVIDER=openai
LG_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LG_MAX_TOKENS=1024
# For Anthropic, set LG_PROVIDER=anthropic and LG_MODEL=claude-sonnet-5.
# Only set effort when the selected provider/model supports it.
# LG_EFFORT=low
# Optional paths resolve from your working directory; otherwise the app uses
# the repository models.json and shared daily FX cache automatically.
# LG_PRICES=models.json
# LG_FX_FILE=/absolute/path/to/usd-eur.json
