# Use the endpoint and project API keys from your Langfuse project settings.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Used only with --live. Default execution simulates the LLM but sends real traces.
LG_PROVIDER=openai
LG_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Optional override; the runtime defaults to 32768 output tokens.
# LG_MAX_TOKENS=32768
# For Anthropic, set LG_PROVIDER=anthropic and LG_MODEL=claude-sonnet-5.
ANTHROPIC_API_KEY=
