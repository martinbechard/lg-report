# Copy to .env here for --live; existing shell variables take precedence.
# Offline mode scripts model choices and needs no provider key.
LG_PROVIDER=openai
LG_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Full replacement text is a tool argument; allow enough output for the document.
LG_MAX_TOKENS=4096
# Optional effort must be supported by the selected provider/model.
# LG_EFFORT=low
