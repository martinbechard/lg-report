# Environment variables take precedence over this file.
LG_PROVIDER=openai
LG_MODEL=gpt-5.6-luna
# Optional comma-separated model/deployment allowlist; unset or blank is unrestricted.
# Copy to .env.local and list the exact IDs available for your selected provider.
# LG_AVAILABLE_MODELS=gpt-5.6-luna,gpt-4.1
# Unavailable requests warn once per model per process and use LG_MODEL.
# If LG_MODEL is missing or is not allowed, model selection raises an error.
# For Anthropic: LG_PROVIDER=anthropic and LG_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, including Azure Foundry's OpenAI v1 API.
# For Azure, use its resource key above and deployment name as LG_MODEL.
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
ANTHROPIC_API_KEY=
# Optional override; the runtime defaults to 32768 output tokens.
# LG_MAX_TOKENS=32768
# Optional pricing file: bypasses automatic daily provider-price refresh.
# LG_PRICES=models.json
# LG_PRICES_CACHE=.cache/lg-report/prices

# Optional USD/EUR JSON rate file: bypasses all exchange-rate network calls.
# LG_FX_FILE=exchange-rate.json
# Successful daily free ECB lookups are cached here (local calendar date).
LG_FX_CACHE=.cache/lg-report/fx

# Optional provider-supported reasoning effort (only set for models that support it).
# LG_EFFORT=low
