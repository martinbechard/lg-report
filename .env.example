# Environment variables take precedence over this file.
LG_PROVIDER=openai
LG_MODEL=gpt-5.6-luna
# For Anthropic: LG_PROVIDER=anthropic and LG_MODEL=claude-sonnet-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LG_MAX_TOKENS=1024
# Optional pricing file: bypasses automatic daily provider-price refresh.
# LG_PRICES=models.json
# LG_PRICES_CACHE=.cache/lg-report/prices

# Optional USD/EUR JSON rate file: bypasses all exchange-rate network calls.
# LG_FX_FILE=exchange-rate.json
# Successful daily free ECB lookups are cached here (local calendar date).
LG_FX_CACHE=.cache/lg-report/fx

# Optional provider-supported reasoning effort (only set for models that support it).
# LG_EFFORT=low
