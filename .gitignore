# Publish the stable teaching outputs; keep ad hoc runs and exporter diagnostics local.
/reports/*
!/reports/index.html
!/reports/README.md
!/reports/simple_chat/
!/reports/tool_chat/
!/reports/shell_script/
!/reports/subagent_chat/
!/reports/context_budget/
