!/reports/*/report.html
!/reports/*/report.xlsx
!/reports/*/run.json
!/reports/*/spans.jsonl
!/reports/*/prices.json
!/reports/*/excel-data.json
!/reports/*/context.json
!/reports/*/edited-summary.txt
